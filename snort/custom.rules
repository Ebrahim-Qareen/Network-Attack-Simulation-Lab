# Network Attack Simulation Lab — custom Snort rules (SID 1000001+)
# Load via pfSense → Services → Snort → Interface → Rules → custom.rules

# 02 SYN flood — 100+ SYNs to one host in 10s
alert tcp any any -> $HOME_NET any (msg:"LAB DOS SYN flood"; flags:S; threshold:type both, track by_dst, count 100, seconds 10; classtype:attempted-dos; sid:1000001; rev:1;)

# 03 ICMP flood — 200+ echo requests to one host in 10s
alert icmp any any -> $HOME_NET any (msg:"LAB DOS ICMP flood"; itype:8; threshold:type both, track by_dst, count 200, seconds 10; classtype:attempted-dos; sid:1000002; rev:1;)

# 06 DNS tunnelling — oversized TXT query
alert udp $HOME_NET any -> any 53 (msg:"LAB DNS possible tunnelling - long TXT query"; content:"|00 10 00 01|"; dsize:>150; classtype:policy-violation; sid:1000003; rev:1;)

# 06 DNS tunnelling — NULL record query (iodine)
alert udp $HOME_NET any -> any 53 (msg:"LAB DNS NULL record query - iodine style"; content:"|00 0a 00 01|"; classtype:policy-violation; sid:1000004; rev:1;)

# 05 Rogue resolver — DNS to anything other than the authorised server
alert udp $HOME_NET any -> !$DNS_SERVERS 53 (msg:"LAB DNS query to non-authorised resolver"; classtype:policy-violation; sid:1000005; rev:1;)

# 07 Metasploit reverse TCP default handler port
alert tcp $HOME_NET any -> $EXTERNAL_NET 4444 (msg:"LAB MALWARE outbound to 4444 - possible reverse shell"; flags:S; classtype:trojan-activity; sid:1000006; rev:1;)

# 08 SSH brute force — 10+ connections to 22 from one source in 60s
alert tcp any any -> $HOME_NET 22 (msg:"LAB BRUTE SSH connection burst"; flags:S; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-recon; sid:1000007; rev:1;)
